{
  "schema_version": 2,
  "execution": {
    "max_parallel_tasks": 1,
    "max_task_attempts": 3,
    "stop_after_minutes": 180,
    "agent_command": [
      "python",
      "scripts/run_claude_task.py",
      "{result_file}",
      "{model}",
      "{effort}",
      "{type}"
    ],
    "enforce_hard_gate": true,
    "enforce_protected_paths": true,
    "hard_gate_command": ["sh", "scripts/verify-task.sh"],
    "prompt_files": {
      "feature": "task-orchestrator.md",
      "research": "task-orchestrator-research.md"
    },
    "verify_prompt_file": "task-orchestrator-verify.md"
  },
  "vcs": {
    "_comment": "Templated argv arrays, same {token} substitution as execution.agent_command. Unset stage_all/commit to disable commit/push entirely (runner then just leaves verified work uncommitted in the worktree). reset_checkout/reset_clean run before every attempt; leave unset only if you want attempts to build on each other's uncommitted state (not recommended — see ORCHESTRATOR_GUIDE.md).",
    "reset_checkout": ["git", "checkout", "--", "."],
    "reset_clean": ["git", "clean", "-fd"],
    "current_branch": ["git", "rev-parse", "--abbrev-ref", "HEAD"],
    "head_commit": ["git", "rev-parse", "HEAD"],
    "status": ["git", "status", "--porcelain"],
    "stage_all": ["git", "add", "-A"],
    "commit": ["git", "commit", "-m", "{message}"],
    "commit_message_template": "orchestrator({task_id}): {task_title}"
  },
  "integration": {
    "strategy": "direct_branch_push",
    "protected_branch": "main"
  },
  "permissions": {
    "allow_network": true,
    "allow_dependency_changes": false,
    "allow_workflow_changes": false,
    "allow_release": false,
    "allow_deployment": false
  },
  "protected_paths": [
    "AGENTS.md",
    "CONTRIBUTING.md",
    ".github/workflows/",
    ".orchestrator/policy.json",
    ".orchestrator/milestone.json",
    ".orchestrator/queue.json"
  ],
  "human_review_required": [
    "public_api_change",
    "dependency_change",
    "security_boundary",
    "migration",
    "ci_policy",
    "protected_path"
  ]
}

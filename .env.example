# SimpleFin Bridge access URL. This is a CREDENTIAL (it embeds a username:password) --
# never commit a real value here or anywhere else in the repo. Copy this file to
# .env.local and set the real value there (.env.local is gitignored).
SIMPLEFIN_ACCESS_URL=

# Static bearer key required to call the /mcp route's get_balances tool. This is a
# CREDENTIAL -- never commit a real value here or anywhere else in the repo. Copy this
# file to .env.local and set the real value there (.env.local is gitignored). If unset,
# the /mcp route rejects all requests.
MCP_BEARER_KEY=

# Supabase project (public values; synced to Vercel by the Supabase integration). Used for the
# standard MCP OAuth sign-in flow.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated emails allowed to use /mcp after signing in via OAuth. Anyone can create a
# Supabase account, so this allowlist is what actually restricts access. Empty = OAuth disabled.
MCP_ALLOWED_EMAILS=
